<% layout("/layouts/boilerplate") %>

  <style>
    #filters {
      display: flex;
      justify-content: space-between;
      justify-items: center;
      align-items: center;
    }

    .icons-wrapper {
      position: relative;
      width: 80%;
    }

    .filter {
      text-align: center;
      margin-right: 2rem;
      margin-top: 2rem;
      opacity: 0.7;
    }

    .icons {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding: 0 40px;
      margin-right: 2rem;
    }

    .icons::-webkit-scrollbar {
      display: none;
    }

    .arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      font-size: 22px;
      cursor: pointer;
      color: black;
      z-index: 10;
      padding: 5px;
    }

/* Left & Right positions */
    .arrow.left {
      left: 0;
      opacity: 0.7;
    }

    .arrow.right {
      right: 0;
      opacity: 0.7;
    }

    .arrow:hover {
      opacity: 1;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }

    .filter p {
      font-size: 0.8rem;
    }

    .tax-info {
      display: none;
    }

    .tax-toggle {
      border: 1px solid black;
      border-radius: 1rem;
      height: 3.25rem;
      padding: 1rem;
      margin-left: 2rem;
      display: flex;
      align-items: center;
      white-space: nowrap;
    }

    .active-filter {
      color: black;
      opacity: 1;
    }
    
  </style>

    <div id="filters">
      <div class="icons-wrapper">
      <div class="arrow left" onclick="moveLeft()">&#10094;</div>
      <div class="icons" id="iconContainer">
      <a href="/listings?category=Trending" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Trending' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
      </a>

      <a href="/listings?category=Rooms" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Rooms' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
      </a>

      <a href="/listings?category=Iconic Cities" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Iconic Cities' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
      </div>
      </a>

      <a href="/listings?category=Mountains" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Mountains' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
      </div>
      </a>

      <a href="/listings?category=Castles" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Castles' ? 'active-filter' : '' %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </div>
      </a>

      <a href="/listings?category=Amazing Pools" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Amazing Pools' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
      </div>
      </a>

      <a href="/listings?category=Camping" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Camping' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
      </div>
      </a>

      <a href="/listings?category=Farms" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Farms' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
      </div>
      </a>

      <a href="/listings?category=Arctic" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Arctic' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
      </div>
      </a>

      <a href="/listings?category=Domes" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Domes' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-house-chimney-window"></i></div>
        <p>Domes</p>
      </div>
      </a>

      <a href="/listings?category=Boats" class="text-decoration-none text-dark">
      <div class="filter <%= category === 'Boats' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
      </div>
      </a>

      </div>
      <div class="arrow right" onclick="moveRight()">&#10095;</div>
      </div>

      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
          <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
      </div>
    </div>

    <% if( category ) {%>
      <div class="mb-3">
        <a href="/listings" class="btn btn-outline-dark">Show All Listings</a>
      </div>
    <%}%>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
      <% for(let listing of listings) {%>
        <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col listing-card">
      <img src="<%= listing.image?.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <%= listing.title %><br/>
          &#8377;<%= listing.price.toLocaleString("en-IN")%>/night
          <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
        </p>
      </div>
    </div>
    </a>
    <%}%>
    </div>

    <script>
      const container = document.getElementById("iconContainer");

      function moveLeft() {
        container.scrollLeft -= 300;
      }

      function moveRight() {
        container.scrollLeft += 300;
      }

      let taxSwitch = document.getElementById("switchCheckDefault");
      taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo) {
          if(info.style.display != "inline") {
            info.style.display = "inline";
          } else {
            info.style.display = "none";
          }
        }
      });

    </script>
